                                 \r\n               + Math.abs\(top - qTop\) + Math.abs\(bottom - qBottom\);                                  \r\n    if \(\(lastDist >= 0\) && \(lastDist\ <= dist\)\) continue;                                             \r\n    lastDist = dist;                                                                                 \r\n    lastIndex = i;                                                             \                      \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj7789 0 obj<</JS(function ShowCompProps_00702AC0D09341ABB6B71EFEDC48C364\(\){var sChoice = app.popUpMenu\("Capacitor Type: Ceramic","Case/Package: 0402","Comment: Capacitor 0.1 uF +/- 5% 16 V 0402","Component Kind: Standard","Description: Chip Capacitor, 0.1 uF, +/- 5%, 1\6 V, 0402 \(1005 Metric\)","Footprint: CAPC1005X56X25ML10T15","Ibis Model: ","Library Name: Carlos Christopher Carbajal Jord\\u00E1n","Library Reference: CMP-001-00001-6","Max Operating Temperature: 125\\u00B0C","Min Operating Temperature: -55\\u00B0C","M\ounting Technology: SM","PCB3D: ","Pin Info: ","Pins: 2","Ripple Current: ","Ripple Current \(AC\): ","RoHS Compliant: True","Signal Integrity: ","Simulation: ","Tolerance: 5%","Value: 100nF","Voltage Rating: 16V"\); if \(sChoice\) {var nUrlPos = sChoice.\search\(/:\\s\(\(http|https|ftp\):\\/\\/\).+/\); if \(nUrlPos !== -1\) {app.launchURL\(sChoice.substr\(nUrlPos+2\), true\);} else {var nPathPos = sChoice.search\(/:\\s\(\(\\/\)|\(\\\\\\\\\)\).+/\); if \(nPathPos !== -1\) app.openDoc\(sChoice.substr\(nPath\Pos+2\)\);};};})/S/JavaScript>>endobj7790 0 obj<</JS(function ShowCompProps_4D404EBB0394457497FAD4FC54C97EDF\(\){var sChoice = app.popUpMenu\("Capacitance: 68uF","Case/Package: Radial","Comment: EEHZA1V680XP","Component Kind: Standard","Construct